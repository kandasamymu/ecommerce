
<article>
  <section class ="Section row">
    <h2 class="section-title">My Cart Products!</h2>
  </section>
  <% if @get_cart_order_products_with_price["order_products"] != [] %>
    <table class="minimalistBlack">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Price</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tfoot>
        <tr>
          <td></td>
          <td>Total</td>
          <td><%= @get_cart_order_products_with_price["total_price"] %></td>
        </tr>
      </tfoot>
        <tbody>
        <% @get_cart_order_products_with_price["order_products"] != [] && @get_cart_order_products_with_price["order_products"].each do |order_product| %>
        <tr>
          <td><%= order_product.product_name %> </td><td><%= order_product.product_price %></td><td><%= order_product.product_quantity %></td>
        </tr>
        <% end %>
      </tbody>
      </tr>
    </table>
    <div class="row" style ="justify-content: flex-end;" >
      <%= form_tag request_place_order_path, method: :post do %>
        <input type="hidden" name="order_id" value ="<%= @get_cart_order_products_with_price["order_products"][0].order_id %>" />
        <button type="submit" class="button-small " style="flex:">Place Order</button>
      <% end %>
    </div>
  <% else %>
    <p>Cart is empty!</p>
    <%= link_to 'Continue Shopping', view_home_path, class: 'button-continue-shopping' %>
  <% end %>
</article>
</body>
</html>
